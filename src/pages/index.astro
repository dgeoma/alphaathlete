      maggiorenne: { testo: 'Ho compiuto 18 anni.' },
      privacy: { testo: 'Ho letto l’informativa sulla privacy e acconsento al trattamento dei miei dati per valutare questa candidatura.', link: '/privacy/', link_testo: 'Leggi l’informativa' },
