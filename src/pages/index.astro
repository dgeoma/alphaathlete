---
// HOME di alphaathlete.com. Ordine delle sezioni, id e testi: copy v2 (§2 mappa, §3 copy, §4 tappe, §5 questionario).
// I testi sono incollati così come sono: per cambiarli si cambia il copy, poi qui.
//   · regole della casa → src/data/regole.ts (le leggono anche /regole/ e il passo delle regole del questionario)
//   · footer            → src/components/FooterSito.astro
//   · meta              → src/config.ts (META)
//   · stili della home  → public/home.css
// La parola «gene» sta solo in #per-chi. Un solo bottone a pillola, «Candidati», quattro volte più il menu.
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import FooterSito from '../components/FooterSito.astro';
import Apertura from '../components/Apertura.astro';
import Riquadro from '../components/Riquadro.astro';
import Portatori from '../components/Portatori.astro';
import Frontone from '../components/Frontone.astro';
import Stendardo from '../components/Stendardo.astro';
import Tappe from '../components/Tappe.astro';
import Gradinata from '../components/Gradinata.astro';
import Questionario from '../components/Questionario.astro';
import ScenaFinale from '../components/ScenaFinale.astro';
import Lambda from '../components/Lambda.astro';
import Lettere from '../components/Lettere.astro';
import { META, LETTERE_ATTIVE } from '../config';
import { regole, romano, titoliRegole, testataRegole } from '../data/regole';

const ancore = [
  { href: '#per-chi', label: 'Per chi è' },
  { href: '#fuori-dentro', label: 'Cosa si allena' },
  { href: '#viaggio', label: 'Il corso' },
  { href: '#come-si-entra', label: 'Come si entra' },
  { href: '#domande', label: 'Domande' },
];

// ---------- §4 · le sei tappe (il numero romano lo mette il palco) ----------
const tappe = [
